# Python cache
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/
venv/

# Large media files (rendered overlays)
*.mov
*.mp4
*.mkv
*.avi

# Rendered audio (ASR intermediates; regenerate with the pipeline scripts)
*.wav
*.mp3
*.m4a
*.flac

# ASR run artifacts: rendered audio and Resolve project backups
runs/*/audio/
runs/*/backups/

# All run folders (transcripts, SRT drafts, reports, logs)
runs/


# OS files
.DS_Store
Thumbs.db
