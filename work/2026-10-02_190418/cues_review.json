[
  {
    "start": 2.1166666666666667,
    "end": 3.1333333333333333,
    "text": "หนึ่ง",
    "start_frame": 127,
    "end_frame": 188
  },
  {
    "start": 3.566666666666667,
    "end": 4.4,
    "text": "สอง",
    "start_frame": 214,
    "end_frame": 264
  },
  {
    "start": 4.9,
    "end": 5.466666666666667,
    "text": "สาม",
    "start_frame": 294,
    "end_frame": 328
  },
  {
    "start": 5.833333333333333,
    "end": 6.716666666666667,
    "text": "สวัสดีทุกคน",
    "start_frame": 350,
    "end_frame": 403
  },
  {
    "start": 6.733333333333333,
    "end": 7.6,
    "text": "กันด้วยนะครับ",
    "start_frame": 404,
    "end_frame": 456
  },
  {
    "start": 7.95,
    "end": 8.783333333333333,
    "text": "ยินดีต้อนรับ",
    "start_frame": 477,
    "end_frame": 527
  },
  {
    "start": 8.916666666666666,
    "end": 9.883333333333333,
    "text": "เข้าสู่คลิปวิดีโอ",
    "start_frame": 535,
    "end_frame": 593
  },
  {
    "start": 9.9,
    "end": 10.95,
    "text": "ของเคที่นะครับ",
    "start_frame": 594,
    "end_frame": 657
  },
  {
    "start": 11.583333333333334,
    "end": 12.233333333333333,
    "text": "วันนี้",
    "start_frame": 695,
    "end_frame": 734
  },
  {
    "start": 12.666666666666666,
    "end": 13.633333333333333,
    "text": "เป็นวันที่ 20 แล้ว",
    "start_frame": 760,
    "end_frame": 818
  },
  {
    "start": 13.7,
    "end": 14.666666666666666,
    "text": "ของการที่เรา",
    "start_frame": 822,
    "end_frame": 880
  },
  {
    "start": 14.683333333333334,
    "end": 15.566666666666666,
    "text": "จะมาปลูกข้าว",
    "start_frame": 881,
    "end_frame": 934
  },
  {
    "start": 15.65,
    "end": 16.566666666666666,
    "text": "จนกว่ายอดผู้ติดตาม",
    "start_frame": 939,
    "end_frame": 994
  },
  {
    "start": 16.7,
    "end": 17.616666666666667,
    "text": "ของเคที่จะถึง",
    "start_frame": 1002,
    "end_frame": 1057
  },
  {
    "start": 17.633333333333333,
    "end": 18.75,
    "text": "10,000 ซับ",
    "start_frame": 1058,
    "end_frame": 1125
  },
  {
    "start": 18.766666666666666,
    "end": 19.433333333333334,
    "text": "กันนะครับทุกคน",
    "start_frame": 1126,
    "end_frame": 1166
  },
  {
    "start": 20.283333333333335,
    "end": 21.766666666666666,
    "text": "บอกเลยว่าหายกันไปนานมาก",
    "start_frame": 1217,
    "end_frame": 1306
  },
  {
    "start": 22.25,
    "end": 23.616666666666667,
    "text": "โดยตอนนี้ครับทุกคน",
    "start_frame": 1335,
    "end_frame": 1417
  },
  {
    "start": 24.083333333333332,
    "end": 25.316666666666666,
    "text": "ล่าสุดของเคที่อะ",
    "start_frame": 1445,
    "end_frame": 1519
  },
  {
    "start": 25.716666666666665,
    "end": 26.416666666666668,
    "text": "ก็อยู่",
    "start_frame": 1543,
    "end_frame": 1585
  },
  {
    "start": 26.916666666666668,
    "end": 27.85,
    "text": "ผู้...ยอดผู้ติดตาม",
    "start_frame": 1615,
    "end_frame": 1671
  },
  {
    "start": 27.95,
    "end": 29.533333333333335,
    "text": "จะอยู่ที่ 1,880",
    "start_frame": 1677,
    "end_frame": 1772
  },
  {
    "start": 30.5,
    "end": 31.016666666666666,
    "text": "บอกเลยว่า",
    "start_frame": 1830,
    "end_frame": 1861
  },
  {
    "start": 31.533333333333335,
    "end": 32.81666666666667,
    "text": "ขอบคุณทุกคนด้วยที่",
    "start_frame": 1892,
    "end_frame": 1969
  },
  {
    "start": 33.4,
    "end": 34.083333333333336,
    "text": "กดติดตาม",
    "start_frame": 2004,
    "end_frame": 2045
  },
  {
    "start": 34.2,
    "end": 34.71666666666667,
    "text": "และเป็นกำลังใจ",
    "start_frame": 2052,
    "end_frame": 2083
  },
  {
    "start": 34.8,
    "end": 35.53333333333333,
    "text": "ให้เคที่มาจนถึง",
    "start_frame": 2088,
    "end_frame": 2132
  },
  {
    "start": 35.65,
    "end": 36.71666666666667,
    "text": "วันที่ 20 แล้วนะครับ",
    "start_frame": 2139,
    "end_frame": 2203
  },
  {
    "start": 36.983333333333334,
    "end": 37.733333333333334,
    "text": "เดี๋ยว ก่อนอื่นผม",
    "start_frame": 2219,
    "end_frame": 2264
  },
  {
    "start": 37.81666666666667,
    "end": 38.36666666666667,
    "text": "ขอปลูกข้าวก่อนนะ",
    "start_frame": 2269,
    "end_frame": 2302
  },
  {
    "start": 38.93333333333333,
    "end": 39.95,
    "text": "ซึ่งบอกเลยว่า",
    "start_frame": 2336,
    "end_frame": 2397
  },
  {
    "start": 40.166666666666664,
    "end": 41.25,
    "text": "ไม่ได้มาทำคลิป",
    "start_frame": 2410,
    "end_frame": 2475
  },
  {
    "start": 41.45,
    "end": 42.13333333333333,
    "text": "นานมาก",
    "start_frame": 2487,
    "end_frame": 2528
  },
  {
    "start": 42.9,
    "end": 43.85,
    "text": "เนื่องจากว่า",
    "start_frame": 2574,
    "end_frame": 2631
  },
  {
    "start": 44.03333333333333,
    "end": 44.95,
    "text": "ช่วงเดือน",
    "start_frame": 2642,
    "end_frame": 2697
  },
  {
    "start": 44.95,
    "end": 46.68333333333333,
    "text": "กัน...กันยา",
    "start_frame": 2697,
    "end_frame": 2801
  },
  {
    "start": 46.81666666666667,
    "end": 47.266666666666666,
    "text": "ครับทุกคน",
    "start_frame": 2809,
    "end_frame": 2836
  },
  {
    "start": 47.35,
    "end": 48.666666666666664,
    "text": "ผมไปลอง",
    "start_frame": 2841,
    "end_frame": 2920
  },
  {
    "start": 50.016666666666666,
    "end": 51.0,
    "text": "หัดทำอะไรมาใหม่",
    "start_frame": 3001,
    "end_frame": 3060
  },
  {
    "start": 51.3,
    "end": 52.5,
    "text": "ถ้าเป็นล่าสุด ณ ตอนนี้",
    "start_frame": 3078,
    "end_frame": 3150
  },
  {
    "start": 52.65,
    "end": 53.233333333333334,
    "text": "ถ้าเป็นเดือนสิบอะ",
    "start_frame": 3159,
    "end_frame": 3194
  },
  {
    "start": 53.45,
    "end": 54.78333333333333,
    "text": "ผมบอกเลยว่าจะมีคลิปวิดีโอ",
    "start_frame": 3207,
    "end_frame": 3287
  },
  {
    "start": 54.81666666666667,
    "end": 55.61666666666667,
    "text": "มากกว่าเดือนเก้าแน่",
    "start_frame": 3289,
    "end_frame": 3337
  },
  {
    "start": 56.1,
    "end": 57.38333333333333,
    "text": "บอกเลยว่าฝากเป็นกำลังใจ",
    "start_frame": 3366,
    "end_frame": 3443
  },
  {
    "start": 57.483333333333334,
    "end": 58.86666666666667,
    "text": "ติดตามให้เคที่ด้วยนะครับ",
    "start_frame": 3449,
    "end_frame": 3532
  },
  {
    "start": 59.5,
    "end": 60.35,
    "text": "แล้วก็ล่าสุด",
    "start_frame": 3570,
    "end_frame": 3621
  },
  {
    "start": 60.78333333333333,
    "end": 62.233333333333334,
    "text": "ถ้าเป็นไลฟ์สตรีม",
    "start_frame": 3647,
    "end_frame": 3734
  },
  {
    "start": 62.9,
    "end": 63.56666666666667,
    "text": "ของวันจันทร์อะ",
    "start_frame": 3774,
    "end_frame": 3814
  },
  {
    "start": 64.18333333333334,
    "end": 64.96666666666667,
    "text": "ต้องขออภัยด้วย",
    "start_frame": 3851,
    "end_frame": 3898
  },
  {
    "start": 65.16666666666667,
    "end": 66.23333333333333,
    "text": "ที่ไม่ได้มาสตรีมนะครับ",
    "start_frame": 3910,
    "end_frame": 3974
  },
  {
    "start": 66.33333333333333,
    "end": 66.95,
    "text": "เพราะว่าล่าสุด",
    "start_frame": 3980,
    "end_frame": 4017
  },
  {
    "start": 67.45,
    "end": 69.08333333333333,
    "text": "พี่ พี่โอมิเนี่ย",
    "start_frame": 4047,
    "end_frame": 4145
  },
  {
    "start": 69.1,
    "end": 70.76666666666667,
    "text": "เขาติดเกี่ยวกับ",
    "start_frame": 4146,
    "end_frame": 4246
  },
  {
    "start": 71.28333333333333,
    "end": 72.46666666666667,
    "text": "เขาติด เขาติดน้ำท่วมอะ",
    "start_frame": 4277,
    "end_frame": 4348
  },
  {
    "start": 73.26666666666667,
    "end": 74.15,
    "text": "ผม ผมปกติ",
    "start_frame": 4396,
    "end_frame": 4449
  },
  {
    "start": 74.16666666666667,
    "end": 75.21666666666667,
    "text": "เวลาผมมาสตรีม Minecraft",
    "start_frame": 4450,
    "end_frame": 4513
  },
  {
    "start": 75.6,
    "end": 76.26666666666667,
    "text": "ผมก็จะไม่ได้แบบ",
    "start_frame": 4536,
    "end_frame": 4576
  },
  {
    "start": 76.41666666666667,
    "end": 77.35,
    "text": "มา มาเล่นคนเดียว",
    "start_frame": 4585,
    "end_frame": 4641
  },
  {
    "start": 77.41666666666667,
    "end": 78.6,
    "text": "ให้คนดูเห็นอะไรประมาณนี้",
    "start_frame": 4645,
    "end_frame": 4716
  },
  {
    "start": 79.08333333333333,
    "end": 81.2,
    "text": "ก็เลยแบบ แคนเซิลไลฟ์ไปก่อน",
    "start_frame": 4745,
    "end_frame": 4872
  },
  {
    "start": 81.41666666666667,
    "end": 82.05,
    "text": "ยังไงก็",
    "start_frame": 4885,
    "end_frame": 4923
  },
  {
    "start": 82.51666666666667,
    "end": 83.63333333333334,
    "text": "ฝากเป็นกำลังใจด้วยนะครับ",
    "start_frame": 4951,
    "end_frame": 5018
  },
  {
    "start": 83.73333333333333,
    "end": 84.65,
    "text": "ใครที่เข้ามาดูแล้ว",
    "start_frame": 5024,
    "end_frame": 5079
  },
  {
    "start": 84.95,
    "end": 85.86666666666666,
    "text": "ยังไม่ได้กดติดตาม",
    "start_frame": 5097,
    "end_frame": 5152
  },
  {
    "start": 85.88333333333334,
    "end": 86.6,
    "text": "ก่อน แล้วก็กดแชร์",
    "start_frame": 5153,
    "end_frame": 5196
  },
  {
    "start": 86.8,
    "end": 87.41666666666667,
    "text": "ฝากด้วยนะครับ",
    "start_frame": 5208,
    "end_frame": 5245
  },
  {
    "start": 88.7,
    "end": 89.75,
    "text": "หากสะดวกยังไง",
    "start_frame": 5322,
    "end_frame": 5385
  },
  {
    "start": 89.76666666666667,
    "end": 91.8,
    "text": "ก็สามารถเอาคลิปนี้ไปแชร์",
    "start_frame": 5386,
    "end_frame": 5508
  },
  {
    "start": 91.83333333333333,
    "end": 93.3,
    "text": "ให้เพื่อน ๆ มากดติดตาม",
    "start_frame": 5510,
    "end_frame": 5598
  },
  {
    "start": 93.31666666666666,
    "end": 94.33333333333333,
    "text": "เคที่ต่อด้วยนะครับ",
    "start_frame": 5599,
    "end_frame": 5660
  },
  {
    "start": 94.85,
    "end": 96.38333333333334,
    "text": "ยังไงก็ไปเจอกัน นะครับทุกคน",
    "start_frame": 5691,
    "end_frame": 5783
  },
  {
    "start": 97.21666666666667,
    "end": 98.16666666666667,
    "text": "บ๊ายบาย",
    "start_frame": 5833,
    "end_frame": 5890
  }
]