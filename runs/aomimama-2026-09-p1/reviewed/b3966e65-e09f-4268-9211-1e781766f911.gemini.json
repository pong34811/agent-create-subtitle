{
  "timeline_id": "b3966e65-e09f-4268-9211-1e781766f911",
  "timeline_name": "ซอมบี้มาได้ไงวะ!-Minecraft-vdo",
  "approved": false,
  "source_model": "gemini-3.7-flash",
  "duration_seconds": 65.0,
  "cues": [
    {
      "start": 0.0,
      "end": 3.111,
      "text": "ทุกคนเคยเป็นแบบมีแผนอย่างนี้คือแบบว่าว่าแผน",
      "source_segment": 0.0,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 3.111,
      "end": 6.222,
      "text": "จริงมันออกมาในหัวแล้วเมื่อสาเหตุข้างในเวลา",
      "source_segment": 0.0,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 6.222,
      "end": 8.0,
      "text": "หนูลงมือคือทำไม่ค่อยเหมือน",
      "source_segment": 0.0,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 8.36,
      "end": 10.42,
      "text": "น้ำลายยืดนั่นดิคนดู",
      "source_segment": 8.36,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 10.96,
      "end": 14.15,
      "text": "นี่ซอมบี้เต็มเลยคนดู",
      "source_segment": 10.96,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 15.7,
      "end": 16.94,
      "text": "มึงมาจากไหนนิ",
      "source_segment": 15.7,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 17.18,
      "end": 18.96,
      "text": "เฮ้ยมันมาได้ไงวะ",
      "source_segment": 17.18,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 19.38,
      "end": 21.08,
      "text": "เฮ้ยมันมาได้ไงอะ",
      "source_segment": 19.38,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 24.38,
      "end": 26.763,
      "text": "เฮ้ยมันมันมันมีข้อผิดพลาดทางเทคนิคหรือเปล่า",
      "source_segment": 24.38,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 26.763,
      "end": 28.02,
      "text": "วะทำไมซอมบี้มันมาได้วะ",
      "source_segment": 24.38,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 30.82,
      "end": 34.5,
      "text": "มันก็ไม่มีทางหลุดหลุดหนิไม่ใช่ซอมบี้ตรงนี้นะคนดู",
      "source_segment": 30.82,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 35.34,
      "end": 37.4,
      "text": "เฮ้ยเดี๋ยวๆๆมันมาได้ไงอะมันไม่ใช่อะมัน",
      "source_segment": 35.34,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 37.4,
      "end": 39.46,
      "text": "ไม่ใช่อะมันไม่ใช่อะแปลกๆนะแปลกๆนะ",
      "source_segment": 35.34,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 39.7,
      "end": 41.56,
      "text": "แปลกๆนะมันมันต้อง",
      "source_segment": 39.7,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 44.02,
      "end": 46.624,
      "text": "เฮ้ยซอมบี้มาจากไหนอะคนดูหรือว่ามันสปอว์น",
      "source_segment": 44.02,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 46.624,
      "end": 47.16,
      "text": "ออกมาวะ",
      "source_segment": 44.02,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 48.4,
      "end": 50.4,
      "text": "แป๊บนะแป๊บนะไม่ใช่อะไม่ใช่อะ",
      "source_segment": 48.4,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 50.88,
      "end": 53.822,
      "text": "มันมีที่มืดหรือเปล่าพี่ตอนนี้มันกลางคืนอะซอมบี้มัน",
      "source_segment": 50.88,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 53.822,
      "end": 55.62,
      "text": "สปอว์นมันสปอว์นเรื่อยๆเนี่ย",
      "source_segment": 50.88,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 56.12,
      "end": 59.9,
      "text": "ไม่พี่ระยะมันแปลกๆอะผมน่าจะกะระยะผิดเว้ย",
      "source_segment": 56.12,
      "gemini_uncertain": false,
      "flags": []
    }
  ],
