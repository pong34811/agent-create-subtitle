  "cues": [
    {
      "start": 4.0,
      "end": 7.95,
      "text": "เหนื่อยจบซะทีแยกย้ายแยกย้ายเหี้ย",
      "source_segment": 4.0,
      "gemini_uncertain": false,
      "flags": []
    },
    {
      "start": 8.0,
      "end": 10.95,
      "text": "ปิดไลฟ์ได้แล้วไปก่อนนะไปแล้ว",
